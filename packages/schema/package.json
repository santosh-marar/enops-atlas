{
  "name": "@enops/atlas-schema",
  "version": "0.1.0-beta.0",
  "description": "Canonical schema IR for Enops Atlas \u2014 DBML parse/render, normalization, validation, diffing and stable digests.",
  "keywords": [
    "enops",
    "atlas",
    "schema",
    "dbml",
    "canonical",
    "postgres",
    "mysql"
  ],
  "homepage": "https://github.com/santosh-marar/enops-atlas/tree/main/packages/schema#readme",
  "bugs": {
    "url": "https://github.com/santosh-marar/enops-atlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santosh-marar/enops-atlas.git",
    "directory": "packages/schema"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dbml/core": "7.1.2",
    "@noble/hashes": "2.0.1"
  },
  "devDependencies": {
    "@types/bun": "^1.3.11"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
