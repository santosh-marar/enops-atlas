{
  "name": "@enops/atlas-generators",
  "version": "0.1.0-beta.0",
  "description": "Deterministic code generators for Enops Atlas \u2014 SQL DDL, Prisma, Drizzle, seed SQL and migration analysis.",
  "keywords": [
    "enops",
    "atlas",
    "codegen",
    "prisma",
    "drizzle",
    "sql"
  ],
  "homepage": "https://github.com/santosh-marar/enops-atlas/tree/main/packages/generators#readme",
  "bugs": {
    "url": "https://github.com/santosh-marar/enops-atlas/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/santosh-marar/enops-atlas.git",
    "directory": "packages/generators"
  },
  "license": "MIT",
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "bun test tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@enops/atlas-schema": "workspace:^"
  },
  "devDependencies": {
    "@prisma/prisma-schema-wasm": "6.19.0-26.2ba551f319ab1df4bc874a89965d8b3641056773",
    "@types/bun": "^1.3.11",
    "drizzle-orm": "^0.45.1",
    "postgres": "^3.4.9",
    "typescript": "6.0.3"
  },
  "peerDependencies": {
    "typescript": "^5 || ^6 || ^7"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  }
}
