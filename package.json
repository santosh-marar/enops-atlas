{
  "name": "enops-atlas",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "api:check": "node scripts/check-exports.mjs",
    "api:snapshot": "node scripts/check-exports.mjs --update",
    "build": "turbo build",
    "build:packages": "pnpm -r --filter @enops/atlas-schema --filter @enops/atlas-graph --filter @enops/atlas-generators --filter @enops/atlas-schema-intelligence build",
    "changeset": "changeset",
    "check": "ultracite check",
    "check:packages": "pnpm -r --filter @enops/atlas-schema --filter @enops/atlas-graph --filter @enops/atlas-generators --filter @enops/atlas-schema-intelligence exec publint && pnpm -r --filter @enops/atlas-schema --filter @enops/atlas-graph --filter @enops/atlas-generators --filter @enops/atlas-schema-intelligence exec attw --pack . --ignore-rules cjs-resolves-to-esm no-resolution",
    "cloc": "cloc . --exclude-dir=node_modules,.next,dist,build,.turbo,coverage,out,.git,.error,.read,graphify-out",
    "dev": "turbo dev",
    "fix": "ultracite fix",
    "prepare": "husky",
    "release": "pnpm release:check && pnpm check && pnpm typecheck && pnpm test && pnpm build:packages && pnpm api:check && pnpm check:packages && pnpm smoke && pnpm audit --prod --audit-level=moderate && changeset publish",
    "release:check": "node scripts/check-release.mjs",
    "smoke": "node scripts/smoke-packages.mjs",
    "test": "turbo test",
    "typecheck": "turbo typecheck",
    "version-packages": "changeset version"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "ultracite fix"
    ]
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^3.0.3",
    "@workspace/typescript-config": "workspace:*",
    "cloc": "2.6.0-cloc",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "publint": "0.3.24",
    "tsdown": "^0.23.0",
    "turbo": "^2.9.18",
    "typescript": "^7.0.2",
    "ultracite": "^7.10.5"
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  }
}
